# ==============================================================================
# PITWALL TELEMETRY ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local development.

# Application Environment: 'development' enables Uvicorn auto-reload, 'production' disables it
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://pitwall-f1.live,https://www.pitwall-f1.live,http://localhost:8000,http://127.0.0.1:8000

# Server Host & Port (used by Docker and local runners)
HOST=0.0.0.0
PORT=8000

# Optional: Path to local disk cache for OpenF1 session data (defaults to .cache)
# CACHE_DIR=.cache
