# ==============================================================================
# PITWALL TELEMETRY ENGINE - ENVIRONMENT TEMPLATE
# (Copy this to .env and set your secure passwords)
# ==============================================================================

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_to_a_secure_password

# Redis Authentication Token
REDIS_PASSWORD=change_this_to_a_secure_redis_token

# Playback Speed Factor
PLAYBACK_FACTOR=10.0
